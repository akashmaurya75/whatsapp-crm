# ---- Application ----
APP_NAME="WhatsApp CRM"
APP_URL=https://crm.example.com
# Generate with: php bin/console key:generate   (never commit the real value)
APP_KEY=
APP_DEBUG=false
APP_FORCE_HTTPS=true
APP_TIMEZONE=UTC
# Comma-separated IPs of reverse proxies whose X-Forwarded-* headers you trust (e.g. 127.0.0.1)
TRUSTED_PROXIES=
ALLOW_REGISTRATION=false
LOG_FILE=

# ---- Database (MySQL 8 in production; sqlite for local/dev) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=whatsapp_crm
DB_USERNAME=whatsapp_crm
DB_PASSWORD=

# ---- Sessions & passwords ----
SESSION_COOKIE=wcrm_session
SESSION_SECURE_COOKIE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED=true

# ---- Mail ("mail" uses the server's sendmail; "file" writes to storage/mail for development only) ----
MAIL_DRIVER=mail
MAIL_FROM=no-reply@example.com

# ---- API ----
API_RATE_LIMIT_PER_MINUTE=120

# ---- WhatsApp ----
DEFAULT_COUNTRY_CODE=91
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v25.0
WHATSAPP_SEND_RATE_PER_SECOND=20
# "Continue with Facebook" (Embedded Signup). Usually set in Admin → Meta app instead of here.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
OPT_OUT_KEYWORDS=stop,unsubscribe,stop all
# Set to false to hide the unofficial OpenWA gateway option entirely
OPENWA_ENABLED=true

# ---- Retention (days; 0 = keep forever) ----
AUDIT_RETENTION_DAYS=365
MESSAGE_RETENTION_DAYS=0

# ---- Background work ----
# worker = a permanent `php bin/console queue:work` process (VPS) + `schedule:run` cron.
# inline = shared hosting: `php bin/console cron` every minute, plus work right after web requests.
QUEUE_MODE=worker
QUEUE_INLINE_SECONDS=20
# Secret for the web cron URL /cron?key=... (empty = web cron disabled). At least 16 characters.
CRON_KEY=
WEB_CRON_SECONDS=25
